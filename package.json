{
  "name": "twilight-labs",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "test": "pnpm --filter @twilight-labs/analysis --filter @twilight-labs/game-twilight --filter @twilight-labs/ocr --filter @twilight-labs/parser --filter @twilight-labs/video --filter @twilight-labs/vision test",
    "dev:all": "bash scripts/dev-all.sh"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.8",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=18"
  }
}
